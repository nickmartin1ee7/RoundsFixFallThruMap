<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>RoundsFixFallThruMap</RootNamespace>
    <AssemblyName>RoundsFixFallThruMap</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowLocalStubs Condition="'$(AllowLocalStubs)' == ''">false</AllowLocalStubs>

    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('/home/nick/.local/share/Steam/steamapps/common/ROUNDS')">/home/nick/.local/share/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('/home/nick/.steam/steam/steamapps/common/ROUNDS')">/home/nick/.steam/steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('C:/Steam/steamapps/common/ROUNDS')">C:/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/ROUNDS')">C:/Program Files (x86)/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('C:/Program Files/Steam/steamapps/common/ROUNDS')">C:/Program Files/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('D:/Steam/steamapps/common/ROUNDS')">D:/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('/mnt/c/Steam/steamapps/common/ROUNDS')">/mnt/c/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('/mnt/c/Program Files (x86)/Steam/steamapps/common/ROUNDS')">/mnt/c/Program Files (x86)/Steam/steamapps/common/ROUNDS</RoundsFolder>
    <RoundsFolder Condition="'$(RoundsFolder)' == '' and Exists('/mnt/c/Program Files/Steam/steamapps/common/ROUNDS')">/mnt/c/Program Files/Steam/steamapps/common/ROUNDS</RoundsFolder>

    <BepInExFolder Condition="'$(BepInExFolder)' == '' and Exists('/home/nick/.config/r2modmanPlus-local/ROUNDS/profiles/TOP/BepInEx/core/BepInEx.dll')">/home/nick/.config/r2modmanPlus-local/ROUNDS/profiles/TOP/BepInEx</BepInExFolder>
    <BepInExFolder Condition="'$(BepInExFolder)' == '' and Exists('$(RoundsFolder)/BepInEx/core/BepInEx.dll')">$(RoundsFolder)/BepInEx</BepInExFolder>
    <UnboundLibPath Condition="'$(UnboundLibPath)' == '' and Exists('/home/nick/.config/r2modmanPlus-local/ROUNDS/profiles/TOP/BepInEx/plugins/willis81808-UnboundLib/UnboundLib.dll')">/home/nick/.config/r2modmanPlus-local/ROUNDS/profiles/TOP/BepInEx/plugins/willis81808-UnboundLib/UnboundLib.dll</UnboundLibPath>
    <UnboundLibPath Condition="'$(UnboundLibPath)' == '' and Exists('$(BepInExFolder)/plugins/UnboundLib.dll')">$(BepInExFolder)/plugins/UnboundLib.dll</UnboundLibPath>
    <UnboundLibPath Condition="'$(UnboundLibPath)' == '' and Exists('$(BepInExFolder)/plugins/willis81808-UnboundLib/UnboundLib.dll')">$(BepInExFolder)/plugins/willis81808-UnboundLib/UnboundLib.dll</UnboundLibPath>
  </PropertyGroup>

  <Target Name="ValidateRoundsFolder" BeforeTargets="BeforeBuild">
    <Error Condition="'$(RoundsFolder)' == '' and '$(AllowLocalStubs)' != 'true'"
           Text="ROUNDS install not found. Set RoundsFolder or build with -p:AllowLocalStubs=true for local-only stub validation." />
  </Target>

  <ItemGroup Condition="'$(RoundsFolder)' != '' and Exists('$(RoundsFolder)/ROUNDS_Data/Managed/Assembly-CSharp.dll') and '$(BepInExFolder)' != '' and Exists('$(BepInExFolder)/core/BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExFolder)/core/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExFolder)/core/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RoundsFolder)/ROUNDS_Data/Managed/Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(RoundsFolder)/ROUNDS_Data/Managed/Photon3Unity3D.dll</HintPath>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(RoundsFolder)/ROUNDS_Data/Managed/PhotonUnityNetworking.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RoundsFolder)/ROUNDS_Data/Managed/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RoundsFolder)/ROUNDS_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RoundsFolder)/ROUNDS_Data/Managed/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnboundLib">
      <HintPath>$(UnboundLibPath)</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RoundsFixFallThruMap.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(AllowLocalStubs)' == 'true' and '$(RoundsFolder)' == ''">
    <Compile Include="Stubs.cs" />
  </ItemGroup>
</Project>
